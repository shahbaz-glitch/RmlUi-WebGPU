#pragma once

#include <SDL3/SDL.h>
#include <webgpu/webgpu.h>

namespace Rml::SDL3WebGPU
{
	struct Surface
	{
		WGPUSurface handle = nullptr;

		// Physical drawable size in pixels.
		int width = 0;
		int height = 0;

		// Apple only:
		// owns the SDL Metal view created for the window.
		// Null on every other platform.
		void* platform_data = nullptr;

		[[nodiscard]]
		bool IsValid() const noexcept
		{
			return handle != nullptr;
		}

		[[nodiscard]]
		bool IsRenderable() const noexcept
		{
			return IsValid() && width > 0 && height > 0;
		}
	};

	// Main-thread only.
	//
	// Creates a WGPUSurface for the supplied SDL_Window.
	// Ownership of SDL_Window remains with the caller.
	[[nodiscard]]
	bool CreateSurface(
		WGPUInstance instance,
		SDL_Window* window,
		Surface& out_surface);

	// Main-thread only.
	//
	// Refreshes the physical drawable size.
	// width/height may become zero while the window is minimized.
	[[nodiscard]]
	bool UpdateDrawableSize(
		SDL_Window* window,
		Surface& surface);

	// Main-thread only.
	//
	// Must be called before SDL_DestroyWindow().
	void DestroySurface(Surface& surface) noexcept;
}
